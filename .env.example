# Copy to .env on the server. Do not commit .env.
# Replace every <placeholder> before starting. Do not commit the filled-in file.

POSTGRES_USER=atom
POSTGRES_PASSWORD=<password>
POSTGRES_DB=atom
POSTGRES_PORT=5432

# Inside Compose the host is "postgres". On the host machine use 127.0.0.1.
# Use the same value you put in POSTGRES_PASSWORD.
DATABASE_URL=postgresql://atom:<password>@postgres:5432/atom

# openssl rand -hex 32
AUTH_SECRET=<long-random-string>

# Public origin of the desk, including scheme. Used for Stripe return URLs.
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
COOKIE_SECURE=false

# Optional Caddy profile. Set ATOM_DOMAIN to a real hostname before using HTTPS.
ATOM_DOMAIN=localhost
ACME_EMAIL=

SEED_USER_EMAIL=operator@atom.local
# Leave unset and `npm run db:seed` prints a one-time password. Set it here only in the untracked .env.
# SEED_USER_PASSWORD=
SEED_USER_NAME=Operator

# Leave blank until you are ready to charge. No live keys belong in git.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DESK=
STRIPE_PRICE_INSTITUTION=
