# Copy to .env on the server. Do not commit .env.

POSTGRES_USER=atom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atom
POSTGRES_PORT=5432

# Inside Compose this host is "postgres". On the host machine use 127.0.0.1.
DATABASE_URL=postgresql://atom:change-me@postgres:5432/atom

# Long random string. The API refuses to boot in production if this still says change-me.
AUTH_SECRET=change-me-to-a-long-random-string

# Public origin of the desk, including scheme. Used for Stripe return URLs.
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
COOKIE_SECURE=false

# Optional Caddy profile. Set ATOM_DOMAIN to a real hostname before using HTTPS.
ATOM_DOMAIN=localhost
ACME_EMAIL=

# Local demo seed. Production refuses the default password below.
SEED_USER_EMAIL=operator@atom.local
SEED_USER_PASSWORD=paper-observer
SEED_USER_NAME=Operator

# Leave blank until you are ready to charge. No live keys belong in git.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DESK=
STRIPE_PRICE_INSTITUTION=
