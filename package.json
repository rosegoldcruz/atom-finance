{
  "name": "atom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "build": "prisma generate && tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "lint": "eslint .",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx scripts/seed.ts",
    "ingest": "tsx scripts/ingest-files.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.5",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
