generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  name         String
  passwordHash String
  createdAt    DateTime            @default(now())
  sessions     Session[]
  memberships  WorkspaceMember[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Workspace {
  id               String                   @id @default(cuid())
  name             String
  timezone         String                   @default("America/Phoenix")
  plan             String                   @default("observer")
  roundTripCostSol Float                    @default(0.000205)
  tenXMultiple     Float                    @default(10)
  crtOverlay       Boolean                  @default(true)
  soundEnabled     Boolean                  @default(false)
  ingestionPaused  Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  members          WorkspaceMember[]
  keys             IngestionKey[]
  batches          IngestionBatch[]
  trades           PaperTrade[]
  opportunities    Opportunity[]
  circulars        CircularQuote[]
  heartbeats       ScannerHeartbeat[]
  borrowers        BorrowerSnapshot[]
  liquidations     LiquidationObservation[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("owner")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model IngestionKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String
  keyHash     String    @unique
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model IngestionBatch {
  id          String    @id @default(cuid())
  workspaceId String
  kind        String
  source      String
  received    Int
  inserted    Int
  skipped     Int
  errorCount  Int
  receivedAt  DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PaperTrade {
  id          String    @id @default(cuid())
  workspaceId String
  dedupeKey   String
  timestamp   DateTime
  dayKey      String
  pair        String
  sizeSol     Float
  buyDex      String
  sellDex     String
  routeKey    String
  netSol      Float
  netUsd      Float
  grossBps    Float
  netBps      Float?
  windowKey   String
  costSol     Float
  tenXFees    Boolean
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, dayKey])
  @@index([workspaceId, pair])
}

model Opportunity {
  id          String    @id @default(cuid())
  workspaceId String
  dedupeKey   String
  timestamp   DateTime
  dayKey      String
  cycle       Int
  pair        String
  sizeSol     Float
  buyDex      String
  sellDex     String
  solIn       Float
  solOut      Float
  grossBps    Float
  costSol     Float
  netSol      Float
  netUsd      Float
  netBps      Float?
  profitable  Boolean
  verified    Boolean
  slotBuy     String?
  slotSell    String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, pair])
}

model CircularQuote {
  id          String    @id @default(cuid())
  workspaceId String
  dedupeKey   String
  timestamp   DateTime
  dayKey      String
  cycle       Int
  pair        String
  sizeSol     Float
  routeOut    String
  routeBack   String
  solOut      Float
  grossBps    Float
  netSol      Float
  netUsd      Float
  profitable  Boolean
  costSol     Float
  tenXFees    Boolean
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
}

model ScannerHeartbeat {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  status      String
  cycle       Int?
  note        String?
  seenAt      DateTime
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, seenAt])
}

model BorrowerSnapshot {
  id            String    @id @default(cuid())
  workspaceId   String
  dedupeKey     String
  chain         String
  protocol      String
  borrower      String
  healthFactor  Float
  collateralUsd Float?
  debtUsd       Float?
  observedAt    DateTime
  dayKey        String
  blockNumber   Int?
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
}

model LiquidationObservation {
  id                String    @id @default(cuid())
  workspaceId       String
  dedupeKey         String
  chain             String
  protocol          String
  borrower          String
  txHash            String
  observedAt        DateTime
  dayKey            String
  collateralAsset   String
  debtAsset         String
  bonusCapturedUsd  Float?
  gasPaidNative     Float?
  winner            String?
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
}
